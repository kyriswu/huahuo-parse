PORT=4763
DOCKERHUB_REPO=magiclaw/huahuo-parse
# Set VERSION_TAG to the published unique version to pull a release.
VERSION_TAG=local
PADDLEOCR_BACKEND=cuda
MODEL_ROOT=/opt/models
PRELOAD_MODEL=true
PADDLE_CPU_THREADS=4
PDF_RENDER_DPI=144
MAX_FILE_SIZE_MB=512
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_REDIRECTS=3
LOG_LEVEL=info
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/storage
# Optional public object-store URL prefix. Otherwise existing object keys are returned.
STORAGE_PUBLIC_BASE_URL=
STORAGE_ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_ALIYUN_OSS_BUCKET=
STORAGE_ALIYUN_OSS_ACCESS_KEY_ID=
STORAGE_ALIYUN_OSS_ACCESS_KEY_SECRET=
STORAGE_ALIYUN_OSS_TIMEOUT_MS=120000
STORAGE_ALIYUN_OSS_KEY_PREFIX=
# macOS only: PADDLEOCR_BACKEND=mlx, MODEL_ROOT=./var/models
MLX_SERVER_URL=http://127.0.0.1:8111/
# MLX_MODEL_PATH defaults to the revision-pinned MODEL_ROOT/PaddleOCR-VL-1.6.
# Optional for fake-IP VPN DNS on development machines only:
# DOWNLOAD_DNS_OVER_HTTPS=https://cloudflare-dns.com/dns-query
